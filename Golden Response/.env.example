# ===========================================
# Personal Expense Tracker - Environment Config
# ===========================================
# Copy this file to server/.env and fill in values

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/expense_tracker

# JWT Authentication
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
